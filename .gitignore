# deps / caches
node_modules/
__pycache__/
*.pyc
.venv/

# heavy generated media (regenerable; logged in media/genlog.jsonl)
media/stems/
media/plates/**/*.mp4
media/plates/**/frames/
media/plates/**/masks/
media/tmp/
video/out/
video/plates/*/frames/
video/plates/*/masks/
*.wav
!media/sfx/**/*.wav

# intermediate look-dev / test media (regenerable or stand-ins)
media/lookdev/inputs/*_raw.*
media/lookdev/analysis/
media/tests/*.mp4
media/plates/**/*.mp3
media/plates/**/*.m4a

# per-frame plate analysis maps (regenerable with tools/pipeline)
video/plates/*/maps/
video/plates/*/f*.jpg
video/plates/*/m*.png
video/lab/node_modules/
